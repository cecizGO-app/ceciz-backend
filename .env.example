# Database Connection (Neon / PostgreSQL)
# Example Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/ceciz?schema=public"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-secret-key-min-32-chars"
BETTER_AUTH_URL="http://localhost:3005"

# Google OAuth (for Buyer login via Better Auth)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudflare R2 Storage (Bukti Pembayaran & Album)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev" # Public URL (R2.dev domain / Custom domain)

# Origin Cors
FRONTEND_ADMIN_URL="origin-admin-frontent-deployed"
FRONTEND_BUYER_URL="origin-buyer-frontent-deployed"
