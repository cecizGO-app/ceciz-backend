generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  OWNER
  STAFF
  BUYER
}

enum CountryCode {
  CH
  KR
  TH
  JP
  INA
}

enum BatchStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  AWAITING_VERIFICATION
  PAID
  OVERDUE
}

enum PaymentMethod {
  BCA
  QRIS
  SEABANK
  SPAY
  CASH
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrackingStatus {
  PO
  ON_SELLER_HAND
  ARRIVED_WH_LUAR
  OTW_INA
  ARRIVED_WH_INA
  BISA_DI_CO
  DONE
}

enum TaxInvoiceStatus {
  DRAFT
  RELEASED
  PAID
  OVERDUE
}

enum NotificationChannel {
  WEB_PUSH
  EMAIL
  IN_APP
}

enum NotificationType {
  INVOICE_NEW
  PAYMENT_REMINDER
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  TRACKING_UPDATE
  TAX_INVOICE_NEW
  TAX_REMINDER
  CHECKOUT_REMINDER
}

enum CashflowType {
  INCOME
  EXPENSE
}

// ==========================================
// AUTHENTICATION MODELS (Better Auth)
// ==========================================

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(BUYER)
  contact       String?
  address       String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]

  // Domain Relations
  batchItems           BatchItem[]
  orders               Order[]
  invoices             Invoice[]
  payments             Payment[]
  verifiedPayments     Payment[]       @relation("VerifiedPayments")
  taxInvoices          TaxInvoice[]
  taxPayments          TaxPayment[]
  verifiedTaxPayments  TaxPayment[]    @relation("VerifiedTaxPayments")
  poAlbums             PoAlbum[]
  administeredBatches  Batch[]         @relation("AdminNyelem")
  cashflowEntries      CashflowEntry[]
  notifications        Notification[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ==========================================
// CORE DOMAIN MODELS
// ==========================================

model Batch {
  id            String      @id @default(cuid())
  countryCode   CountryCode
  batchNumber   Int
  batchDate     DateTime
  description   String?
  shippingFee   Decimal?    @db.Decimal(14, 2) // Tidak ada di INA
  feeGo         Decimal     @default(0) @db.Decimal(14, 2)
  feeRekap      Decimal     @default(0) @db.Decimal(14, 2)
  feeNyelem     Decimal     @default(0) @db.Decimal(14, 2)
  rateHarian    Decimal?    @db.Decimal(14, 4) // Kurs hari ini (tidak ada di INA)
  feeWh         Decimal?    @db.Decimal(14, 2)
  feeProxy      Decimal?    @db.Decimal(14, 2)
  adminNyelemId String?
  adminNyelem   User?       @relation("AdminNyelem", fields: [adminNyelemId], references: [id])
  proxyCoName   String?
  status        BatchStatus @default(OPEN)

  // Summary / Computed Cache fields
  hargaTotal    Decimal?    @db.Decimal(14, 2)
  hargaTfSeller Decimal?    @db.Decimal(14, 2)
  selisihHarga  Decimal?    @db.Decimal(14, 2)
  labaBersih    Decimal?    @db.Decimal(14, 2)

  items         BatchItem[]
  orders        Order[]
  invoices      Invoice[]
  tracking      Tracking?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([countryCode, batchNumber])
  @@map("batches")
}

model BatchItem {
  id                String   @id @default(cuid())
  batchId           String
  batch             Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  buyerId           String
  buyer             User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerName         String?
  description       String
  hargaAsli         Decimal  @db.Decimal(14, 2) // Mata uang negara asal
  feeNyelem         Decimal? @db.Decimal(14, 2) // Optional override per item
  hargaPerBuyer     Decimal? @db.Decimal(14, 2) // Hasil kalkulasi IDR (CH/KR/TH)
  hargaJualPerBuyer Decimal? @db.Decimal(14, 2) // Khusus JP: admin input manual
  pcs               Int      @default(1)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([batchId])
  @@index([buyerId])
  @@map("batch_items")
}

model Order {
  id          String      @id @default(cuid())
  batchId     String
  batch       Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  itemQty     Int         @default(1)
  orderStatus OrderStatus @default(PENDING)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([batchId])
  @@index([buyerId])
  @@map("orders")
}

model Invoice {
  id              String        @id @default(cuid())
  buyerId         String
  buyer           User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  batchId         String
  batch           Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  totalAmount     Decimal       @db.Decimal(14, 2)
  itemDetail      Json          // Array detail item: [{item_name, qty, harga_per_buyer}]
  jpHargaJual     Decimal?      @db.Decimal(14, 2)
  invoiceStatus   InvoiceStatus @default(UNPAID)
  deadlinePayment DateTime
  penaltyAmount   Decimal       @default(0) @db.Decimal(14, 2)

  payments        Payment[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([buyerId])
  @@index([batchId])
  @@map("invoices")
}

model Payment {
  id                 String             @id @default(cuid())
  invoiceId          String
  invoice            Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  buyerId            String
  buyer              User               @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  paymentProofUrl    String
  amount             Decimal            @db.Decimal(14, 2)
  paymentMethod      PaymentMethod
  paymentDate        DateTime
  verificationStatus VerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedBy         User?              @relation("VerifiedPayments", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?
  rejectReason       String?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([invoiceId])
  @@index([buyerId])
  @@map("payments")
}

model Tracking {
  id              String         @id @default(cuid())
  batchId         String         @unique
  batch           Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  countryCode     CountryCode
  trackingStatus  TrackingStatus @default(PO)
  resiNumber      String[]       @default([])
  whName          String?
  boxNo           String?
  description     String?
  checkedOut      Boolean        @default(false) // Admin monitoring checklist
  uploadedToAlbum Boolean        @default(false) // Admin monitoring checklist
  notes           String?
  isArchived      Boolean        @default(false)
  archivedAt      DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("tracking")
}

// ==========================================
// TAX MANAGEMENT MODELS
// ==========================================

model TaxInvoice {
  id               String           @id @default(cuid())
  releaseName      String
  releasePeriod    String
  buyerId          String
  buyer            User             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  coveredBatchIds  String[]         @default([])
  breakdownDetail  Json             // [{batch_id, batch_number, country, item_desc, qty, rate_tax, subtotal_tax}]
  taxInvoiceTotal  Decimal          @db.Decimal(14, 2)
  deadlinePayment  DateTime
  maxCheckoutDate  DateTime
  status           TaxInvoiceStatus @default(DRAFT)
  penaltyAmount    Decimal          @default(0) @db.Decimal(14, 2)

  payments         TaxPayment[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([buyerId])
  @@map("tax_invoices")
}

model TaxPayment {
  id                    String             @id @default(cuid())
  taxInvoiceId          String
  taxInvoice            TaxInvoice         @relation(fields: [taxInvoiceId], references: [id], onDelete: Cascade)
  buyerId               String
  buyer                 User               @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  taxPaymentProofUrl    String
  amount                Decimal            @db.Decimal(14, 2)
  paymentMethod         PaymentMethod
  taxVerificationStatus VerificationStatus @default(PENDING)
  verifiedById          String?
  verifiedBy            User?              @relation("VerifiedTaxPayments", fields: [verifiedById], references: [id])
  verifiedAt            DateTime?

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([taxInvoiceId])
  @@index([buyerId])
  @@map("tax_payments")
}

model WhInvoice {
  id               String   @id @default(cuid())
  whInvoiceTotal   Decimal  @db.Decimal(14, 2)
  coveredBatchIds  String[] @default([])
  allocationRatio  Json?    // {batch_id: ratio}
  allocatedAmount  Json?    // {batch_id: amount}
  invoiceDate      DateTime
  notes            String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("wh_invoices")
}

// ==========================================
// NOTIFICATIONS & CASHFLOW
// ==========================================

model Notification {
  id               String              @id @default(cuid())
  buyerId          String
  buyer            User                @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  channel          NotificationChannel
  type             NotificationType
  title            String
  body             String
  triggeredByEvent String
  referenceId      String?
  isRead           Boolean             @default(false)

  createdAt        DateTime            @default(now())

  @@index([buyerId])
  @@map("notifications")
}

model CashflowEntry {
  id            String         @id @default(cuid())
  entryDate     DateTime
  description   String
  amount        Decimal        @db.Decimal(14, 2)
  type          CashflowType
  category      String?
  paymentMethod PaymentMethod?
  createdById   String
  createdBy     User           @relation(fields: [createdById], references: [id])

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("cashflow_entries")
}

model PoAlbum {
  id             String         @id @default(cuid())
  buyerId        String
  buyer          User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  batchNumber    String
  itemName       String
  qty            Int            @default(1)
  totalQty       Int?
  harga          Decimal        @db.Decimal(14, 2)
  totalHarga     Decimal        @db.Decimal(14, 2)
  dpAmount       Decimal        @db.Decimal(14, 2)
  dpMethod       PaymentMethod
  fpAmount       Decimal?       @db.Decimal(14, 2)
  fpMethod       PaymentMethod?
  trackingStatus TrackingStatus @default(PO)
  notes          String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([buyerId])
  @@map("po_album")
}

model Setting {
  id                  String   @id @default("singleton")
  defaultFeeNyelem    Decimal  @default(2000) @db.Decimal(12, 2)
  dailyRate           Json     // { "CH": 2200, "KR": 12, "TH": 450, "JP": 110 }
  penaltyPerDay       Decimal  @default(2000) @db.Decimal(12, 2)
  deadlineBatchHours  Int      @default(24)
  deadlineTaxHours    Int      @default(72)
  taxRatePcChThJp     Decimal  @default(7000) @db.Decimal(12, 2)
  taxRatePcKr         Decimal  @default(6000) @db.Decimal(12, 2)
  taxRateNonPcPerGram Decimal? @db.Decimal(12, 2)
  feeRekapTiers       Json     // [{ "min_pcs": 1, "max_pcs": 1, "fee": 2000 }, ...]
  maxStorageDays      Int      @default(60)

  updatedAt           DateTime @updatedAt

  @@map("settings")
}
